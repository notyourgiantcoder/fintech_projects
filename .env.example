# Copy to .env and fill in. Every service below has a free tier that needs no credit card.
# This one file serves both the backend and the frontend (Vite reads it via envDir).
# Only VITE_-prefixed values ever reach the browser.

# --- Sign-in (Clerk: dashboard.clerk.com) ---
CLERK_PUBLISHABLE_KEY=        # pk_test_...; the API uses it to find Clerk's public signing keys
VITE_CLERK_PUBLISHABLE_KEY=   # the same pk_test_... value, for the browser
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173   # sites allowed to send tokens
# Local development without Clerk (never on a deployed server):
# FINBO_DEV_AUTH=1
# VITE_DEV_AUTH=1

# --- LLMs ---
GITHUB_TOKEN=            # GitHub Models (primary LLM): github.com/settings/tokens, "models:read" scope
GOOGLE_API_KEY=          # Gemini fallback: aistudio.google.com/apikey  (demo data only on free tier)
GROQ_API_KEY=            # Llama Guard / Prompt Guard safety models: console.groq.com

# --- Market data & research ---
FINNHUB_API_KEY=         # finnhub.io
FRED_API_KEY=            # fred.stlouisfed.org/docs/api/api_key.html
TAVILY_API_KEY=          # tavily.com (optional; DuckDuckGo works without a key)
FINBO_CONTACT=           # your email or a URL; SEC EDGAR and Wikipedia require a contact to serve data

# --- Telegram (optional): message @BotFather, send /newbot, paste the token here ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=   # the bot's username without @, used for "Open the bot" links
# FINBO_TELEGRAM_IN_API=1   # run the bot inside `finbo serve` (one process, e.g. on a Space)

# --- Microsoft Graph (OneDrive / SharePoint Excel) ---
MS_CLIENT_ID=            # Entra app registration (free, no Azure subscription needed)
MS_TENANT_ID=common      # "common" = personal + work/school accounts

# --- Storage & observability ---
DATABASE_URL=            # Neon Postgres: neon.tech
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
